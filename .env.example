# Canonical site URL (used for metadataBase, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://evglab.com

# Google Search Console verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code

# Google Analytics 4 Measurement ID (optional; only loaded after cookie consent)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID (optional; only loaded after marketing cookie consent)
# NEXT_PUBLIC_META_PIXEL_ID=919588920489707

# Web3Forms (form notifications to your inbox)
# NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key
# WEB3FORMS_KEY=your_web3forms_access_key

# Resend – personalized confirmation emails after Festpreis signup
# 1) Create account at https://resend.com
# 2) Add & verify domain evglab.com at https://resend.com/domains (DNS required!)
# 3) Create API key
# Without a verified domain, confirmation emails will fail (from address rejected).
RESEND_API_KEY=
EMAIL_FROM=Erik von Gregory <info@evglab.com>